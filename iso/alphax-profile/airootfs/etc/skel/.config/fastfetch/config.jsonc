{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/alphax.txt",
        "type": "file",
        "color": {
            "1": "35",
            "2": "55"
        },
        "padding": {
            "right": 4
        }
    },
    "display": {
        "color": "magenta",
        "separator": " → "
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "35",
                "at": "magenta",
                "host": "55"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "  Paquetes",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": "  GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "  RAM",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "  Disco",
            "keyColor": "magenta"
        },
        "separator",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
