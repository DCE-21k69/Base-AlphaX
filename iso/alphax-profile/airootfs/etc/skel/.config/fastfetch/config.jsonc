{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/alphax.txt",
        "type": "file",
        "color": {
            "1": "magenta",
            "2": "blue"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "color": "magenta",
        "separator": " ❯ "
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "magenta",
                "at": "white",
                "host": "blue"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "󰣇  Distro",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌽  Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "⚡ Modo",
            "keyColor": "blue",
            "text": "if [ -f /tmp/codex-gamemode.lock ]; then echo 'ZERO-LAG Competitivo (BBR)'; else echo 'Tokyo Night (Gaming Ready)'; fi"
        },
        {
            "type": "wm",
            "key": "󱂬  WM",
            "keyColor": "magenta",
            "format": "Codex WM ({1})"
        },
        {
            "type": "shell",
            "key": "󰆍  Shell",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "󰞷  Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏖  Paquetes",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "󰻠  CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "󰍛  RAM",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "󰋊  Disco",
            "keyColor": "blue"
        },
        "separator",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
