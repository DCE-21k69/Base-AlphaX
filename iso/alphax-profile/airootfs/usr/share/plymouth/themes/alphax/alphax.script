// ═══════════════════════════════════════════════════════════════════
// AlphaX Linux — Script de Animación Plymouth (Efecto Breathing + Spinner Neón)
// ═══════════════════════════════════════════════════════════════════

// Fondo Tokyo Night (#1a1b26)
Window.SetBackgroundTopColor(0.102, 0.106, 0.149);
Window.SetBackgroundBottomColor(0.086, 0.086, 0.118);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + (Window.GetWidth()  / 2) - (logo.image.GetWidth()  / 2);
logo.y = Window.GetY() + (Window.GetHeight() / 2) - (logo.image.GetHeight() / 2) - 30;
logo.sprite.SetPosition(logo.x, logo.y, 10);

spinner.image = Image("spinner.png");
spinner.sprite = Sprite();
spinner.x = Window.GetX() + (Window.GetWidth()  / 2) - (spinner.image.GetWidth()  / 2);
spinner.y = logo.y + logo.image.GetHeight() + 18;
spinner.sprite.SetPosition(spinner.x, spinner.y, 20);

global.tick = 0;

fun refresh_callback () {
    global.tick++;

    // Rotación suave del anillo neón (60 FPS)
    angle = (global.tick * 0.12);
    spinner.sprite.SetImage(spinner.image.Rotate(angle));

    // Efecto respiración suave (estilo Zorin OS) sobre el emblema AlphaX
    pulse = 0.85 + (0.15 * Math.Sin(global.tick * 0.06));
    logo.sprite.SetOpacity(pulse);
}

Plymouth.SetRefreshFunction(refresh_callback);
