#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# AlphaX Linux — Aplicador de Identidad del Sistema (os-release / lsb-release)
# Se ejecuta en el build y automáticamente vía Pacman Hook tras actualizar 'filesystem'
# ═══════════════════════════════════════════════════════════════════
set -euo pipefail

cat > /usr/lib/os-release << 'EOF'
NAME="AlphaX Linux"
PRETTY_NAME="AlphaX Linux (Gaming Edition)"
ID=alphax
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;122;162;247"
HOME_URL="https://github.com/DCE-21k69/Base-AlphaX"
DOCUMENTATION_URL="https://github.com/DCE-21k69/Base-AlphaX"
SUPPORT_URL="https://github.com/DCE-21k69/Base-AlphaX/issues"
BUG_REPORT_URL="https://github.com/DCE-21k69/Base-AlphaX/issues"
LOGO=archlinux-logo
EOF

cp -f /usr/lib/os-release /etc/os-release

cat > /etc/lsb-release << 'EOF'
DISTRIB_ID="AlphaX"
DISTRIB_RELEASE="rolling"
DISTRIB_CODENAME="Codex"
DISTRIB_DESCRIPTION="AlphaX Linux (Gaming Edition)"
EOF
